@@ -6,6 +6,105 @@ import pytest
 
 from gateway.config import Platform, PlatformConfig
 from gateway.platforms import api_server
+from gateway.platforms import api_server_run_idempotency as run_idempotency
+from gateway.platforms.api_server_run_idempotency import RunIdempotencyStore
+
+
+def test_approval_receipts_are_scope_bound_durable_and_retained(tmp_path, monkeypatch):
+    now = 1_800_000_000.0
+    monkeypatch.setattr(run_idempotency.time, "time", lambda: now)
+    db_path = str(tmp_path / "runs.db")
+    store = RunIdempotencyStore(db_path)
+
+    store.prepare_approval_receipt("scope-a", "run-a", "req-1", "once")
+    store.prepare_approval_receipt("scope-b", "run-b", "req-1", "deny")
+    assert store.get_approval_receipt("scope-a", "run-a", "req-1")["state"] == "prepared"
+    assert store.get_approval_receipt("scope-b", "run-b", "req-1")["choice"] == "deny"
+    assert store.get_approval_receipt("scope-a", "run-b", "req-1") is None
+    store.close()
+
+    monkeypatch.setattr(run_idempotency.time, "time", lambda: now + 86_401)
+    restarted = RunIdempotencyStore(db_path)
+    assert restarted.get_approval_receipt("scope-a", "run-a", "req-1")["state"] == "prepared"
+    restarted.commit_approval_receipt("scope-a", "run-a", "req-1")
+    restarted.close()
+
+    after_restart = RunIdempotencyStore(db_path)
+    receipt = after_restart.get_approval_receipt("scope-a", "run-a", "req-1")
+    assert receipt["choice"] == "once"
+    assert receipt["state"] == "committed"
+    assert receipt["resolved"] == 1
+    after_restart.close()
+
+
+def test_approval_receipts_fail_closed_without_durable_sqlite():
+    store = RunIdempotencyStore(":memory:")
+    with pytest.raises(RuntimeError, match="durable"):
+        store.prepare_approval_receipt("scope-a", "run-a", "req-1", "once")
+    with pytest.raises(RuntimeError, match="durable"):
+        store.get_approval_receipt("scope-a", "run-a", "req-1")
+    with pytest.raises(RuntimeError, match="durable"):
+        store.commit_approval_receipt("scope-a", "run-a", "req-1")
+    store.close()
+
+
+def test_terminal_run_expiry_prunes_its_approval_receipts(tmp_path, monkeypatch):
+    now = 1_800_000_000.0
+    monkeypatch.setattr(run_idempotency.time, "time", lambda: now)
+    store = RunIdempotencyStore(str(tmp_path / "receipt-expiry.db"))
+    store.reserve(
+        "scope-a",
+        "key-a",
+        "fingerprint-a",
+        "run-a",
+        {"run_id": "run-a", "status": "completed"},
+    )
+    store.prepare_approval_receipt("scope-a", "run-a", "req-1", "once")
+    store.commit_approval_receipt("scope-a", "run-a", "req-1")
+
+    monkeypatch.setattr(
+        run_idempotency.time,
+        "time",
+        lambda: now + RunIdempotencyStore.RETENTION_SECONDS + 1,
+    )
+    store.reserve(
+        "scope-b",
+        "key-b",
+        "fingerprint-b",
+        "run-b",
+        {"run_id": "run-b", "status": "running"},
+    )
+    assert store.get_approval_receipt("scope-a", "run-a", "req-1") is None
+    store.close()
+
+
+def test_fresh_receipt_survives_old_terminal_run_expiry(tmp_path, monkeypatch):
+    now = 1_800_000_000.0
+    monkeypatch.setattr(run_idempotency.time, "time", lambda: now)
+    store = RunIdempotencyStore(str(tmp_path / "fresh-receipt.db"))
+    store.reserve(
+        "scope-a", "key-a", "fingerprint-a", "run-a",
+        {"run_id": "run-a", "status": "completed"},
+    )
+    monkeypatch.setattr(
+        run_idempotency.time, "time",
+        lambda: now + RunIdempotencyStore.RETENTION_SECONDS - 1,
+    )
+    store.prepare_approval_receipt("scope-a", "run-a", "req-1", "once")
+    store.commit_approval_receipt("scope-a", "run-a", "req-1")
+    monkeypatch.setattr(
+        run_idempotency.time, "time",
+        lambda: now + RunIdempotencyStore.RETENTION_SECONDS + 1,
+    )
+    store.reserve(
+        "scope-b", "key-b", "fingerprint-b", "run-b",
+        {"run_id": "run-b", "status": "running"},
+    )
+    assert store.status_for_run("scope-a", "run-a") is not None
+    receipt = store.get_approval_receipt("scope-a", "run-a", "req-1")
+    assert receipt is not None
+    assert receipt["state"] == "committed"
+    store.close()
 
 
